rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasUserProfile() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUserRole() {
      return hasUserProfile()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isBootstrapAdmin() {
      return isSignedIn()
        && request.auth.token.email in ['hsab7164@gmail.com'];
    }

    function isAdmin() {
      return isBootstrapAdmin() || currentUserRole() == 'admin';
    }

    match /users/{userId} {
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email
        && (
          (
            isBootstrapAdmin()
            && request.resource.data.role == 'admin'
            && request.resource.data.approvalStatus == 'approved'
          ) ||
          (
            request.resource.data.role == 'patient'
            && request.resource.data.approvalStatus == 'approved'
          ) ||
          (
            request.resource.data.role == 'pharmacist'
            && request.resource.data.approvalStatus == 'pending'
          )
        );

      allow read: if isSignedIn()
        && (request.auth.uid == userId || isAdmin());

      allow update: if isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.approvalStatus == resource.data.approvalStatus
          && request.resource.data.email == resource.data.email
        );

      allow delete: if isAdmin();
    }

    match /medications/{docId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;

      allow read: if isSignedIn()
        && (
          isAdmin()
          || resource.data.userId == request.auth.uid
        );

      allow update, delete: if isSignedIn()
        && (
          isAdmin()
          || resource.data.userId == request.auth.uid
        );
    }

    match /pharmacy/{docId} {
      allow create: if isSignedIn()
        && currentUserRole() == 'pharmacist'
        && request.resource.data.pharmacistId == request.auth.uid;

      allow read: if isSignedIn()
        && (
          isAdmin()
          || resource.data.pharmacistId == request.auth.uid
        );

      allow update, delete: if isSignedIn()
        && (
          isAdmin()
          || resource.data.pharmacistId == request.auth.uid
        );
    }

    match /admin/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
